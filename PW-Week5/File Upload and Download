//Classromm Activit 2 on Download
test('Download', async ({ page }) => {
    await page.goto("https://the-internet.herokuapp.com/download")
    const download = page.waitForEvent('download')
    await page.locator("//a[text()='5555.png']").click()
    const downloadPromise = await download
    await downloadPromise.saveAs('Utils/' + downloadPromise.suggestedFilename())
    expect(downloadPromise.suggestedFilename()).toBe('5555.png')
})


//Homework File upload and Download - Using Input Tag (setInputFiles)
test.only('HW File upload and Download Relative Path', async ({ page }) => {
    await page.goto('https://the-internet.herokuapp.com/upload')
    //Single File upload Using Relative path
    const fileUpload1 = page.locator("input[id='file-upload']")
    await fileUpload1.setInputFiles('Utils/test-upload.txt')
    await page.waitForTimeout(2000)
    const fileName = await fileUpload1.inputValue()
    expect(fileName).toContain('test-upload.txt')
})

test('HW File upload and Download Absolute Path', async ({ page }) => {
    await page.goto('https://the-internet.herokuapp.com/upload')
    //Single File upload using Absolute Path
    const fileUpload2 = page.locator("input[id='file-upload']")
    await fileUpload2.setInputFiles(path.join(__dirname, '../Utils/test-upload.txt'))
    await page.waitForTimeout(2000)
    const fileName1 = await fileUpload2.inputValue()
    expect(fileName1).toContain('test-upload.txt')
})

//Homework File upload and Download - Using Event Listener
test('HW Using Event Listener Relative Path', async ({ page }) => {
    await page.goto("https://the-internet.herokuapp.com/upload")
    const fileUpload3 = page.waitForEvent('filechooser')
    await page.locator("div[id='drag-drop-upload']").click()
    const fileUploadPromise = await fileUpload3
    //using Relative Path For Multiple Files
    await fileUploadPromise.setFiles(["Utils/test-upload.txt", "Utils/hello.json"])
    await page.waitForTimeout(2000)
    const fileNames = await page.locator("//div[@class='dz-filename']").allTextContents()
    console.log(fileNames)
    expect(fileNames).toContain('test-upload.txt')
    expect(fileNames).toContain('hello.json')
})

test('HW Using Event Listener Absolute Path', async ({ page }) => {
    await page.goto("https://the-internet.herokuapp.com/upload")
    const fileUpload3 = page.waitForEvent('filechooser')
    await page.locator("div[id='drag-drop-upload']").click()
    const fileUploadPromise = await fileUpload3
    //using Absolute Path for Multiple Files
    await fileUploadPromise.setFiles([path.join(__dirname, '../../Utils/test-upload.txt'),
    path.join(__dirname, '../../Utils/hello.json')])
    await page.waitForTimeout(2000)
    //write assertion
    const fileNames1 = await page.locator("//div[@class='dz-filename']").allTextContents()
    console.log(fileNames1)
    expect(fileNames1).toContain('test-upload.txt')
    expect(fileNames1).toContain('hello.json')

})

