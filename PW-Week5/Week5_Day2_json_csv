import { test } from '@playwright/test';

//Classroom Activity 1 : Login Salesforce with 2 sets of Data
import login from '../../Data/salesforce.json'

for(let value of login) {
test(`learn to read json file ${value.TestCaseID}` , async({page}) => {
    await page.goto('https://login.salesforce.com')
    await page.getByText('Username', {exact:true}).fill(value.UserName)
    await page.getByRole('button',{name:'Log In'}).click()
    await page.getByLabel('Password',{exact : true}).fill(value.password)
    await page.getByRole('button',{name:'Log In'}).click()
    await page.waitForTimeout(2000)
})    
}

//Classroom Activity 2 : Read Data from CSV
import {parse} from 'csv-parse/sync'
import fs from 'fs'
let csvData = fs.readFileSync('Utils/leafTaps.csv', 'utf-8')
let csvValue :any[] = parse(csvData , {skip_empty_lines : true , columns : true })
console.log(csvValue)
for(let value1 of csvValue ){
test(`Leaftaps login Data para ${value1.tcId}` , async({page}) => {
    await page.goto('https://leaftaps.com/opentaps/control/main')
    await page.locator('#username').fill(value1.userName)
    await page.locator('#password').fill(value1.password)
    await page.locator("//input[@value='Login']").click()
})
}

